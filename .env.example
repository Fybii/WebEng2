# Liegt im Projektroot (neben package.json), NICHT in src/
# Nach Änderungen: npm run dev neu starten

# Optional: Google Places API key for POI ratings (e.g. "4,3 ★★★★☆")
# Create at https://console.cloud.google.com/ – enable "Places API"
VITE_GOOGLE_PLACES_API_KEY=

# Required for "Nicht über Autobahn" / "Spritsparend" routing (free tier at openrouteservice.org)
VITE_ORS_API_KEY=
